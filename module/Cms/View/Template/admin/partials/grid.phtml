<?php

use Krystal\Widget\GridView\GridViewWidget;

?>

<?php if (isset($title)): ?>
<div class="card-header bg-light">
    <h5 class="card-title mb-0">
        <i class="bi bi-list-ul me-2"></i> <?= $this->translate($title); ?> 
        <span class="badge bg-secondary rounded-pill ms-1"><?= count($rows); ?></span>
    </h5>
</div>
<?php endif; ?>

<div class="table-responsive">
    <?= $this->widget(new GridViewWidget($rows, $grid)); ?>
</div>

<?php if (empty($rows)): ?>
<div class="card-body py-5 text-center">
    <h2 class="text-muted"><i class="bi bi-folder-x"></i> <?= $this->translate('No records'); ?></h2>
</div>
<?php endif; ?>

<?php if (isset($pagination)): ?>
<div class="card-footer bg-white border-top-0">
    <?php $this->loadPartial('paginator'); ?>
</div>
<?php endif; ?>