<?php

use Krystal\Widget\GridView\GridViewWidget;
use Krystal\Form\Element;
use Cms\View\Icon;

?>

<div class="btn-toolbar mb-3">
    <?php $this->loadPartial('menu', [
        'items' => [
            'Cms:Admin:Languages@addAction' => 'Add a language'
        ],
        'actions' => [
            'data' => $langs,
            'save' => 'Cms:Admin:Languages@tweakAction',
        ]
    ]); ?>
</div>

<div class="card">
    <div class="card-header">
        <h4 class="card-title mb-0">
            <i class="bi bi-translate"></i> <?= $this->translate('Languages'); ?> 
            <small class="text-muted">(<?= count($langs); ?>)</small>
        </h4>
    </div>

    <form>
        <div class="table-responsive">
            <?= $this->widget(new GridViewWidget($langs, [
                'batch' => false,
                'pk' => 'id',
                'tableClass' => 'table table-hover table-striped mb-0',
                'columns' => [
                    [
                        'column' => 'id',
                        'label' => '#'
                    ],
                    [
                        'column' => 'flag',
                        'value' => function($language){
                            return sprintf('<i class="famfamfam-flag-%s"></i>', $language->getFlag());
                        }
                    ],
                    [
                        'column' => 'code'
                    ],
                    [
                        'column' => 'name'
                    ],
                    [
                        'column' => 'order',
                        'value' => function($language){
                            return Element::number(sprintf('order[%s]', $language->getId()), $language->getOrder(), ['class' => 'form-control form-control-sm mx-auto', 'style' => 'max-width: 80px;', 'min' => '0']);
                        }
                    ],
                    [
                        'column' => 'published',
                        'value' => function($language){
                            return Element::checkbox(sprintf('published[%s]', $language->getId()), $language->getPublished(), ['class' => 'form-check-input']);
                        }
                    ],
                    [
                        'column' => 'default',
                        'value' => function($language){
                            return Element::radio('default', $language->getId(), $language->getDefault(), ['class' => 'form-check-input']);
                        }
                    ]
                ],
                'actions' => [
                    function($language){
                        return Icon::edit(
                            $this->url('Cms:Admin:Languages@editAction', $language->getId()),
                            $this->translate('Edit this language')
                        );
                    },
                    function($language){
                        return Icon::remove(
                            $this->url('Cms:Admin:Languages@deleteAction', $language->getId()),
                            $this->translate('Remove this language')
                        );
                    }
                ]
            ])); ?>
            
            <?php if (empty($langs)): ?>
            <div class="card-body text-center py-5">
                <h2 class="text-muted"><i class="bi bi-exclamation-circle"></i> <?= $this->translate('No languages'); ?></h2>
            </div>
            <?php endif; ?>
        </div>
    </form>
</div>