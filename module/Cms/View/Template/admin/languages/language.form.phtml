<?php

use Krystal\Form\Element;

?>

<form class="card" autocomplete="off">
    <div class="card-body">
        <?= Element::hidden('language[id]', $language->getId()); ?>

        <div class="mb-3">
            <label class="form-label"><?= $this->translate('Name'); ?></label>
            <div class="input-group">
                <?= Element::text('language[name]', $language->getName(), ['class' => 'form-control', 'placeholder' => $this->translate('The name of the language to be created')]); ?>
                <span class="input-group-text"><i class="fas fa-pencil-alt"></i></span>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6">
                <div class="mb-3">
                    <label class="form-label"><?= $this->translate('Country'); ?> <i data-container="flag" class="fas fa-flag"></i></label>
                    <?= Element::select('language[flag]', $countries, $language->getFlag(), ['class' => 'form-select'], null, function($code, $name){
                        return [
                            'data-flag' => sprintf('famfamfam-flag-%s', strtolower($code))
                        ];
                    }); ?>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="mb-3">
                    <label class="form-label"><?= $this->translate('Code'); ?></label>
                    <?= Element::text('language[code]', $language->getCode(), ['class' => 'form-control', 'placeholder' => $this->translate('Unique language identifier')]); ?>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label"><?= $this->translate('Order'); ?></label>
            <?= Element::number('language[order]', $language->getOrder(), ['class' => 'form-control', 'min' => '0', 'placeholder' => $this->translate('Language sort order in a list')]); ?>
        </div>

        <div class="form-check mb-3">
            <?= Element::checkbox('language[published]', $language->getPublished(), ['class' => 'form-check-input', 'id' => 'published-check']); ?>
            <label class="form-check-label" for="published-check">
                <?= $this->translate('Published'); ?>
            </label>
        </div>

        <?php if (!$language->getId()): ?>
        <div class="form-check mb-3">
            <?= Element::checkbox('language[default]', $language->getDefault(), ['class' => 'form-check-input', 'id' => 'default-check']); ?>
            <label class="form-check-label" for="default-check">
                <?= $this->translate('Make default'); ?>
            </label>
        </div>
        <?php endif; ?>
    </div>

    <?php $this->loadPartial('actions', [
        'new' => !$language->getId(),
        'add' => 'Cms:Admin:Languages@addAction',
        'edit' => 'Cms:Admin:Languages@editAction',
        'save' => 'Cms:Admin:Languages@saveAction',
        'cancel' => 'Cms:Admin:Languages@indexAction'
    ]); ?>
</form>