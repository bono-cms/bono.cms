<?php

use Krystal\Widget\GridView\GridViewWidget;
use Krystal\Form\Element;
use Cms\View\Icon;
use Cms\Service\ThemeService;

?>

<div class="btn-toolbar">
	<div class="dropdown">
	  <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown">
		<i class="bi bi-list-ul"></i> <?= $this->translate('Menu'); ?>
	  </button>

	  <div class="dropdown-menu">
        <a class="dropdown-item" href="#" data-button="module-install" data-url="<?= $this->url('Cms:Admin:Themes@tweakAction'); ?>" title="<?= $this->translate('Click to Install a module from ZIP archive'); ?>"><i class="bi bi-wrench"></i> <?= $this->translate('Install a module');?></a>
		<a class="dropdown-item" href="#" data-button="remove-selected" data-url="<?= $this->url('Cms:Admin:ModuleManager@deleteManyAction'); ?>"><i class="bi bi-x-circle"></i> <?= $this->translate('Remove selected'); ?></a>
	  </div>

      <input type="file" name="module" accept=".zip" class="d-none" />
	</div>
</div>

<div class="card">
    <div class="card-body">
        <h2 class="page-header"><?= $this->translate('Modules'); ?> <span class="text-muted">(<?= count($modules); ?>)</span></h2>

        <form>
            <div class="table-responsive">
                <?= $this->widget(new GridViewWidget($modules, [
                    'tableClass' => 'table table-hover table-bordered table-striped',
                    'pk' => 'name',
                    'batch' => true,
                    'batchCallback' => function($module) use ($moduleManager){
                        return isset($module['name']) ? !$moduleManager->isCoreModule($module['name']) : false;
                    },
                    'columns' => [
                        [
                            'column' => 'name',
                            'translateable' => true,
                            'attributes' => [
                                'class' => null
                            ]
                        ],

                        [
                            'column' => 'description',
                            'translateable' => true,
                            'attributes' => [
                                'class' => null
                            ]
                        ]
                    ],

                    'actions' => [
                        function($module) use ($moduleManager){
                            if (!$moduleManager->isCoreModule($module['name'])) {
                                return Icon::remove(
                                    $this->url('Cms:Admin:ModuleManager@deleteAction', $module['name']),
                                    $this->translate('Remove this module')
                                );
                            } else {
                                return null;
                            }
                        }
                    ]
                ])); ?>

                <?php if (empty($modules)): ?>
                <div class="center-block">
                    <h2 class="text-center text-muted"><i class="bi bi-x-circle"></i> <?= $this->translate('No modules'); ?></h2>
                </div>
                <?php endif; ?>
            </div>
        </form>
    </div>
</div>