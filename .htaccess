# ---------------------------------------------------------------
# CMS .htaccess — Portable (Apache 2.2/2.4, LiteSpeed, PHP-FPM)
# ---------------------------------------------------------------

# Disable directory listing
Options -Indexes

# Hide server version
ServerSignature Off

# Default charset
AddDefaultCharset UTF-8

# Front controller
<IfModule dir_module>
    DirectoryIndex index.php
</IfModule>

# ---------------------------------------------------------------
# 1. BLOCK SENSITIVE FILES (Composer, Git, Configs, Readme)
# ---------------------------------------------------------------
<FilesMatch "^(composer\.(json|lock)|README\.md|nginx\.conf|\.user\.ini|\.git(ignore|attributes))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------
# 2. ALLOW ONLY FRONT CONTROLLER, BLOCK OTHER PHP FILES
# ---------------------------------------------------------------
<IfModule mod_authz_core.c>
    # Apache 2.4+
    <FilesMatch "\.(php|phtml)$">
        Require all denied
    </FilesMatch>
    <Files "index.php">
        Require all granted
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    # Apache 2.2
    <FilesMatch "\.(php|phtml)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <Files "index.php">
        Order allow,deny
        Allow from all
    </Files>
</IfModule>

# ---------------------------------------------------------------
# 3. PASS AUTHORIZATION HEADER TO PHP (JWT / Bearer Tokens)
# ---------------------------------------------------------------
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header to PHP
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    # Redirect www → non-www (Always force HTTPS to prevent loops)
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # Send everything else to the front controller (except real files/dirs)
    RewriteBase /
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule . index.php [L]
    
</IfModule>

# Fallback when mod_rewrite is not available
<IfModule !mod_rewrite.c>
    ErrorDocument 404 /index.php
</IfModule>